# Copy to .env and fill in locally. Shell environment variables take precedence.
# Only the local coordinator receives these credentials.
EXA_API_KEY=
PASTDEV_API_KEY=
OPENAI_API_KEY=
# Set a Responses API model available to your OpenAI project.
SKEPTIC_PROPOSER_MODEL=
SKEPTIC_MEMORY_BACKEND=pastdev

# Supply BOTH values, or leave both empty and use an authenticated Modal profile.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# Optional local profile name, not a workspace ID.
MODAL_PROFILE=
MODAL_ENVIRONMENT=main
SKEPTIC_APP_NAME=skeptic
